{
  "name": "clawd-pet",
  "version": "1.3.0",
  "description": "Clawd 桌面宠物 - 纯可爱,零功能",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.example.clawdpet",
    "productName": "Clawd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "llm.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}